{
	"schemaVersion": 1,
	"id": "homegui",
	"version": "${version}",
	"name": "HomeGUI",
	"description": "A simple sethome mod with a GUI for Fabric.",
	"icon": "assets/homegui/icon.png",
	"authors": [
		"Nighter"
	],
	"contact": {
		"homepage": "https://nighterezi.github.io/HomeGUI/",
		"issues": "https://github.com/Nighterezi/HomeGUI/issues",
		"sources": "https://github.com/Nighterezi/HomeGUI"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.homegui.HomeGui"
		],
		"client": [
			"com.homegui.client.HomeGuiClient"
		],
		"modmenu": [
			"com.homegui.client.HomeGuiModMenu"
		]
	},
	"mixins": [
		{
			"config": "homegui.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
